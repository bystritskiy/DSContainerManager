<plist version="1.0">
<dict>
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsLocalNetworking</key>
		<true/>
	</dict>
	<key>NSLocalNetworkUsageDescription</key>
	<string>DSContainer connects directly to your Synology NAS on your local network to manage its Docker containers.</string>
	<key>BGTaskSchedulerPermittedIdentifiers</key>
	<array>
		<string>com.dscontainermanager.container-health-check</string>
	</array>
	<key>UIBackgroundModes</key>
	<array>
		<string>fetch</string>
	</array>
</dict>
</plist>
